# Build the DNS server from this checkout rather than downloading an upstream
# release binary. Station pins this repository as a git submodule, so the
# resulting service image is tied to that exact, reviewable source revision.
FROM golang:1.25-bookworm AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' \
    -o /out/sslip.io-dns-server .

FROM alpine:3.22

COPY --from=build /out/sslip.io-dns-server /usr/sbin/sslip.io-dns-server

ENTRYPOINT ["/usr/sbin/sslip.io-dns-server"]

# The server accepts DNS over both protocols. The Compose service publishes
# both UDP and TCP port 53.
EXPOSE 53/tcp
EXPOSE 53/udp
